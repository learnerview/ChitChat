# ChitChat Environment Configuration
# Copy this file to .env and fill in your production values
# Do NOT commit .env to version control

# === REQUIRED FOR PRODUCTION ===

# JWT Secret Key - Must be a long, random, secure string in production
# Generate one with: openssl rand -hex 32
JWT_SECRET=your-secure-random-jwt-secret-here-min-32-chars

# MongoDB Connection URI
# For local development: mongodb://localhost:27017/chitchat
# For cloud: mongodb+srv://user:password@cluster.mongodb.net/chitchat?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/chitchat

# === OPTIONAL / DEFAULTS ===

# Server Configuration
SERVER_PORT=8080

# MongoDB Auto Index Creation (true = automatically create indexes on startup)
MONGODB_AUTO_INDEX=true

# JWT Token Expiration (in milliseconds)
# 86400000 = 24 hours
JWT_EXPIRATION_MS=86400000

# Logging Levels
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_CHITCHAT=INFO

# === EXTERNAL AUTHENTICATION (Optional) ===
# Enable if you want to accept external JWT tokens from another auth provider

EXTERNAL_AUTH_ENABLED=false
EXTERNAL_AUTH_VERIFY_SIGNATURE=true
EXTERNAL_AUTH_JWT_SECRET=
EXTERNAL_AUTH_USERNAME_CLAIM=preferred_username
EXTERNAL_AUTH_USER_ID_CLAIM=sub
EXTERNAL_AUTH_AUTO_PROVISION_USER=false
